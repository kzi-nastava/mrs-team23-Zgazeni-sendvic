<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP (cleartext) only to the local dev backend. On API 28+ cleartext
  is blocked by default, so the Spring server (http://...:8080) would be unreachable
  without this. Production HTTPS hosts are unaffected.

  Hosts:
    - 10.0.2.2      : the host machine as seen from the standard Android emulator
    - 192.168.1.113 : this PC's LAN IP, so a physical phone on the same Wi-Fi can reach
                      the backend. Emulators keep working via 10.0.2.2 regardless.
    - localhost / 127.0.0.1 : loopback (also covers `adb reverse tcp:8080 tcp:8080`)
  Testing from a different machine? Add that PC's LAN IP below, and point the app at it
  with backendUrl=http://your-ip-here:8080/ in local.properties. Do NOT edit
  ApiClient.BASE_URL; it now reads the value from the build. See app/build.gradle.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.2.104</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
