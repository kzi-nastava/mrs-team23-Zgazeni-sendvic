<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= MAP ================= -->

    <org.osmdroid.views.MapView
        android:id="@+id/rideOrderMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================= BOTTOM SHEET ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/orderPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="64dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="150dp"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drag handle -->

            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <!-- TITLE -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order a ride"
                        android:textColor="@color/bluack"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- START -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Start"
                        app:startIconDrawable="@drawable/ic_marker_start">

                        <AutoCompleteTextView
                            android:id="@+id/orderStartInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- MIDDLE STOPS -->

                    <LinearLayout
                        android:id="@+id/stopsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/addStopButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add stop" />

                    <!-- DESTINATION -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:hint="Destination"
                        app:startIconDrawable="@drawable/ic_marker_end">

                        <AutoCompleteTextView
                            android:id="@+id/orderDestinationInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- VEHICLE -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle type"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/vehicleTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <!-- SPECIAL REQUIREMENTS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/babiesCheckBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Baby transport" />

                        <CheckBox
                            android:id="@+id/petsCheckBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pet transport" />

                    </LinearLayout>

                    <!-- PASSENGERS -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Additional passengers"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/passengerEmailInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Passenger email"
                            android:inputType="textEmailAddress"
                            android:maxLines="1" />

                        <Button
                            android:id="@+id/addPassengerButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/passengersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- SCHEDULE -->

                    <RadioGroup
                        android:id="@+id/scheduleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/nowRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Ride now" />

                        <RadioButton
                            android:id="@+id/scheduleRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Schedule ride" />

                    </RadioGroup>

                    <android.widget.TimePicker
                        android:id="@+id/scheduleTimePicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- SUMMARY -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/orderDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distance: —"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/orderDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Time: —"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/orderPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price: —"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ORDER -->

                    <Button
                        android:id="@+id/orderRideButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="ORDER RIDE"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/orderProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>