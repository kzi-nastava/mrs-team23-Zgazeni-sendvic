<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/greyBlue"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/horRideRouteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start → Destination"
            android:textColor="@color/bluack"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/horRideDateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="2026-08-25 18:00"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/horRideFareTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="1250 RSD"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/horRideStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/bluack"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="SCHEDULED"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startRideButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/lightBlue"
            android:text="Start ride"
            android:textColor="@color/black" />

    </LinearLayout>

</androidx.cardview.widget.CardView>